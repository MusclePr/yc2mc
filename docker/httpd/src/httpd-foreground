#!/bin/bash
set -e

source /etc/apache2/envvars

# サイトの有効化
# SITES_ENABLEが指定されていなければ、sites-available内のすべての設定ファイルを有効化
if [ -z "$SITES_ENABLE" ]; then
    for conf in /etc/apache2/sites-available/*.conf; do
        [ -e "$conf" ] && a2ensite $(basename "$conf")
    done
else
    a2ensite $SITES_ENABLE
fi

# PIDファイルが残っていると起動に失敗する場合があるため削除
rm -f /var/run/apache2/apache2.pid

# Apacheをフォアグラウンドで実行
# execを使用することで、このシェルスクリプトのプロセスがApacheに置き換わります
exec apache2 -DFOREGROUND
